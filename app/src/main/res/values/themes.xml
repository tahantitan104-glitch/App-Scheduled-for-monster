<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Resolve.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forest_brand_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_resolve_splash</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.Resolve</item>
    </style>

    <style name="Theme.Resolve" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/forest_brand_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Resolve.LockScreen" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/forest_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Resolve.TranslucentSignIn" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
